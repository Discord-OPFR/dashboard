{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky install .husky",
    "dev": "concurrently \"npx vite --host\" \"npm run watch:features-locales\" \"npm run watch:sources-locales\"",
    "build": "npm run generate:assets && tsc -b && vite build",
    "watch:features-locales": "npx papaya locales:watch",
    "watch:sources-locales": "npx papaya locales:build",
    "fmt": "prettier --write \"src/**/*.{js,jsx,cjs,ts,tsx,json,css,scss,md}\"",
    "fmt:check": "prettier --check \"src/**/*.{js,jsx,cjx,ts,tsx,json,md}\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:ts": "eslint . --ext=.ts,.tsx",
    "lint:ts:fix": "eslint . --ext=.ts,.tsx --fix",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:fix": "npm run lint:ts:fix && npm run lint:scss",
    "generate:assets": "npm run generate:icons && npm run generate:translations",
    "generate:translations": "cp node_modules/@opfr/items/locales/items/fr.json public/locales/fr/items.json && cp node_modules/@opfr/items/locales/equipments/fr.json public/locales/fr/equipments.json",
    "generate:icons": "rm -rf src/components/icons && npx @svgr/cli --memo --no-dimensions --no-prettier --no-index --out-dir src/components/icons -- src/assets/icons && npx eslint src/components/icons --fix",
    "api-specs:create": "npm run api-specs:download && npm run api-specs:generate",
    "api-specs:download": "node scripts/fetchApiSpecs.mjs",
    "api-specs:generate": "npx openapi-typescript-codegen --exportCore=false --client fetch --input api-specs/openapi.json --output src/api/generated && prettier --write \"src/api/generated\""
  },
  "dependencies": {
    "@gatewatcher/bistoury": "1.12.0",
    "@gatewatcher/skin": "1.0.1",
    "@opfr/emojis": "0.16.0",
    "@opfr/items": "0.35.10",
    "@opfr/ornaments": "0.18.3",
    "@opfr/translate": "0.4.3",
    "@opfr/utils-lang": "0.17.3",
    "@opfr/utils-type": "0.18.7",
    "@reduxjs/toolkit": "2.10.1",
    "@tanstack/react-query": "5.90.10",
    "i18next": "25.6.1",
    "i18next-fetch-backend": "7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.2.4",
    "react-redux": "9.2.0",
    "react-router-dom": "7.9.5"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/compat": "1.4.1",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@opfr/papaya": "file:../papaya",
    "@svgr/cli": "8.1.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "@types/node": "24.6.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.46.3",
    "@typescript-eslint/parser": "8.46.3",
    "@vitejs/plugin-react": "5.0.4",
    "commit-and-tag-version": "12.6.0",
    "concurrently": "9.2.1",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "husky": "8.0.3",
    "lint-staged": "16.2.6",
    "openapi-typescript-codegen": "0.29.0",
    "prettier": "3.6.2",
    "sass": "1.93.3",
    "stylelint": "16.25.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-recommended": "17.0.0",
    "stylelint-config-recommended-scss": "16.0.2",
    "stylelint-order": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.2.2",
    "vite-tsconfig-paths": "5.1.4"
  }
}
